    "repository": "https://github.com/samline/scroll-spy",
    "namespace": "samline-scroll-spy",
    "template": false,
    "credit": "samline"
  },
  "theme": {
    "accentLight": "#7e22ce",
    "accentDark": "#d8b4fe"
  },
  "delivery": {
